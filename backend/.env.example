# ก๊อปไฟล์นี้เป็น .env แล้วเติมค่าของเครื่องตัวเอง
# .env ไม่ถูก commit ขึ้น git

# บังคับต้องมี ถ้าขาดแอปจะไม่ยอมสตาร์ต
DATABASE_URL=postgresql+psycopg://garage:garage@localhost:5432/garage
JWT_SECRET=ใส่ข้อความสุ่มยาว ๆ ที่ไม่ซ้ำใคร

# ไม่บังคับ ใส่เมื่อต้องการทับค่าเริ่มต้นใน app/config.py
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=480
